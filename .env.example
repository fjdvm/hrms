# Base address of the Portal (central sign-in site).
PORTAL_URL=https://portal.example.com
# The System name HRMS is registered under in the Portal.
PORTAL_SYSTEM_NAME=HRMS
# HRMS backend credential for the Portal. Generate once at registration; never commit a real value.
PORTAL_SYSTEM_SECRET=
# Public origin of this app (deployed: https://hrms-arae.vercel.app; defaults to http://localhost:3001). The Portal callback is <origin>/api/portal/callback and must be registered.
HRMS_APP_URL=http://localhost:3001
# Development and tests ONLY: act as a fully-permitted Staff member with no Portal. HRMS refuses to
# start if this is set in production or with a non-localhost HRMS_APP_URL.
# HRMS_DEV_BYPASS=true

# Neon Postgres (pooled connection string). Set in Vercel on hrms-arae for Production and
# Preview (sensitive). Real value never goes in this file or in git.
DATABASE_URL=
# Direct (non-pooled) connection string, for migrations. Same Vercel setup as above.
DIRECT_URL=

# Protects the scheduled Job Posting deadline sweep.
CRON_SECRET=
# Bearer key the Careers site sends to /api/careers/* (offer replies and document uploads)
CAREERS_CALLER_KEY=

# Gateway Caller must be registered with system code HRMS.
API_GATEWAY_URL=
API_GATEWAY_CALLER_KEY=
# The gateway Caller App name for HRMS (bell inbox and live tickets). Defaults to HRMS.
NOTIFICATIONS_APP=HRMS

# Government IDs: a base64-encoded 32-byte key, generated once and held in the server environment.
# Keep a secure backup; replacing it makes existing ciphertext unreadable. Never prefix with NEXT_PUBLIC_.
HRMS_EMPLOYEE_ENCRYPTION_KEY=
# Explicit opt-in for synthetic Employee records (node scripts/seed-employees.mjs).
# HRMS_ALLOW_DEMO_SEED=true
