# Production settings for the Vercel project. Real values live in the git-ignored
# .env.production and in Vercel > Environment Variables (Production). Never commit secrets.

# Public, read at BUILD time (set before the first build).
NEXT_PUBLIC_HRMS_URL=https://hrms.buildwrite.me/
# Optional overrides of the sidebar links (defaults are the addresses below).
NEXT_PUBLIC_HOST_URL=https://portal.buildwrite.me/
NEXT_PUBLIC_CRMS_URL=https://creoms.buildwrite.me/

# Public addresses (not secret).
PORTAL_URL=https://portal.buildwrite.me
HRMS_APP_URL=https://hrms.buildwrite.me
API_GATEWAY_URL=https://api.buildwrite.me
CAREERS_URL=https://shop.buildwrite.me
PORTAL_SYSTEM_NAME=HRMS

# Secret. HRMS's System secret from the Portal (npm run system:register in the Portal repo).
PORTAL_SYSTEM_SECRET=
# Secret. Neon pooled and direct connection strings.
DATABASE_URL=
DIRECT_URL=
# Secret. Protects the daily /api/cron/job-postings call.
CRON_SECRET=
# Secret. Gateway credentials for HRMS.
API_GATEWAY_KEY=
API_GATEWAY_CALLER_KEY=

# MUST NOT be set on Vercel: HRMS_DEV_BYPASS (the app refuses to start with it).
